rules_version = '2';

// Security model
// - Clients may only READ, and only after entering the shared club password
//   (a Cloud Function sets role = "member" or "admin" on the session).
// - Every create / update / delete goes through Cloud Functions, which check
//   the admin role or name + PIN ownership. No client writes are allowed.
// - Collections not listed here (memberSecrets, ballots, bookCache,
//   reviewCache, rateLimits) are closed to every client, admins included.
service cloud.firestore {
  match /databases/{database}/documents {
    function isClubMember() {
      return request.auth != null
        && request.auth.token.role in ['member', 'admin'];
    }

    match /config/{doc} {
      allow read: if isClubMember();
    }
    match /pastMeetings/{id} {
      allow read: if isClubMember();
    }
    match /members/{memberId} {
      allow read: if isClubMember();
    }
    match /polls/{pollId} {
      allow read: if isClubMember();
      match /availability/{memberId} {
        allow read: if isClubMember();
      }
    }
    match /proposals/{bookKey} {
      allow read: if isClubMember();
    }
    match /elections/{electionId} {
      allow read: if isClubMember();
    }
    match /comments/{commentId} {
      allow read: if isClubMember();
    }
    match /potlucks/{potluckId} {
      allow read: if isClubMember();
      match /items/{itemId} {
        allow read: if isClubMember();
      }
    }

    // Everything else is denied by default.
  }
}
